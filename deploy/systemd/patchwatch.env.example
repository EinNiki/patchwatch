# /etc/patchwatch/patchwatch.env: Einstellungen für den Dienst patchwatch-server (Rechte 0640, Gruppe patchwatch).
# Eine Zeile je Variable, ohne Anführungszeichen. Alle weiteren Variablen: siehe .env.example im Repository.

# Datenbank (PostgreSQL 15 oder neuer, lokal oder im Netz). Beispiel anlegen:
#   sudo -u postgres createuser patchwatch --pwprompt && sudo -u postgres createdb -O patchwatch patchwatch
PATCHWATCH_DATABASE_URL=postgres://patchwatch:PASSWORT@127.0.0.1:5432/patchwatch

# Der Server lauscht nur lokal; der Reverse-Proxy (deploy/systemd/Caddyfile.example) leitet /api dorthin.
PATCHWATCH_LISTEN=127.0.0.1:8080
# Hinter dem Reverse-Proxy: Client-IP aus X-Forwarded-For für die Rate-Limits.
PATCHWATCH_TRUST_PROXY=true
# Öffentliche Adresse der Instanz (für Passkeys und OIDC), mit Hostnamen und https, z. B. https://patchwatch.example.org
PATCHWATCH_PUBLIC_URL=https://patchwatch.example.org
# Nur für Tests über http ohne TLS auf false setzen (Sitzungs-Cookie dann ohne Secure-Flag):
# PATCHWATCH_COOKIE_SECURE=false

PATCHWATCH_TIMEZONE=Europe/Berlin
PATCHWATCH_CVE_SOURCES=ubuntu,debian

# Schlüssel für gespeicherte Geheimnisse (Benachrichtigungskanäle, OIDC/LDAP). Erzeugen: openssl rand -base64 32
# Getrennt von der Datenbank sichern: ohne ihn sind die Geheimnisse unlesbar.
# PATCHWATCH_SECRET_KEY=

# Erster Start: Passwort für den Benutzer "admin" (mind. 12 Zeichen); danach die Zeile entfernen.
# Leer = Zufallspasswort, einmal im Journal: journalctl -u patchwatch-server | grep -i passwort
# PATCHWATCH_ADMIN_PASSWORD=
