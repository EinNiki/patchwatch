# /etc/patchwatch/agent.toml  (enthält keinen Token; der liegt in /etc/patchwatch/token, ändern mit: sudo patchwatch-agent set-token)
server_url = "https://patchwatch.example.org"
# Liste der installierten Pakete mitsenden (Reiter "Pakete" je Host, Übersicht "Pakete"). Die volle Liste geht nur dann
# an den Server, wenn sie sich geändert hat (sonst nur ein Hash); höchstens 20.000 Pakete. Ohne diese Zeile gilt "false".
include_packages = true
timeout_secs = 30
# Check-in: fragt den Server regelmäßig, ob ein Report gewünscht ist ("Jetzt aktualisieren" in der Web-UI).
# Der Server kann nur "Report jetzt senden" mitteilen. Abschalten: checkin_enabled = false
# (und optional: systemctl disable --now patchwatch-agent-checkin.timer).
checkin_enabled = true
checkin_interval_secs = 300
# Long-Poll: der Server hält den Check-in bis zu so viele Sekunden offen und antwortet sofort, sobald in der UI
# "Jetzt aktualisieren" gedrückt wird (0-55; 0 = nur alle checkin_interval_secs fragen).
checkin_wait_secs = 40

# Docker-Container und Image-Versionen melden (Standard: aus; ohne diese Zeile öffnet der Agent den Docker-Socket nie).
# Es werden nur Name, Status, Image-Angabe, Image-Digests und die Compose-Namen gelesen, nie Umgebungsvariablen,
# Befehle, Mounts oder andere Labels. Empfohlen: ein Socket-Proxy auf Loopback, der nur Container und Images lesen lässt.
# docker_enabled = true
# docker_endpoint = "http://127.0.0.1:2375"           # Socket-Proxy (nur Loopback erlaubt)
# docker_endpoint = "unix:///var/run/docker.sock"     # direkter Socket (Gruppe docker ist faktisch Root)
