# Kopieren nach .env und die Werte eintragen. Die .env gehört nicht ins Repository und nicht in Chats.
# Keine Anführungszeichen um die Werte. Danach: docker compose up -d
#
# Passwörter und Schlüssel selbst erzeugen:
#   openssl rand -hex 24        (Passwörter; nur Buchstaben und Ziffern, damit die URL unten nicht bricht)
#   openssl rand -base64 32     (SECRET_KEY)

# ---- Datenbank ------------------------------------------------------------------------------
# EINTRAGEN: Passwort der Datenbank (z. B. mit `openssl rand -hex 24` erzeugt)
POSTGRES_PASSWORD=
# EINTRAGEN: dasselbe Passwort wie oben statt DATENBANK_PASSWORT. Rest unverändert lassen.
PATCHWATCH_DATABASE_URL=postgres://patchwatch:DATENBANK_PASSWORT@postgres:5432/patchwatch

# ---- Pflicht --------------------------------------------------------------------------------
# EINTRAGEN: Schlüssel für gespeicherte Geheimnisse (Kanal-Token, 2FA). Genau 32 Byte in Base64,
# erzeugen mit `openssl rand -base64 32`. Getrennt von der Datenbank sichern; ohne ihn sind sie unlesbar.
PATCHWATCH_SECRET_KEY=
# EINTRAGEN (optional): Start-Passwort für den Benutzer "admin", mindestens 12 Zeichen. Gilt nur beim allerersten
# Start. Leer lassen: der Server erzeugt ein Zufallspasswort und zeigt es einmal im Log (docker compose logs server).
PATCHWATCH_ADMIN_PASSWORD=

# ---- Adresse und Proxy ----------------------------------------------------------------------
# EINTRAGEN: genau die Adresse, unter der du patchwatch im Browser aufrufst (mit https://, ggf. mit Port).
# Beispiel: https://patchwatch.example.org oder http://192.168.1.10
PATCHWATCH_PUBLIC_URL=https://DEINE-DOMAIN.de
# true = Login-Cookie nur über HTTPS (richtig hinter einem Proxy mit TLS).
# Nur bei Betrieb per http://IP ohne HTTPS auf false setzen, sonst funktioniert das Login nicht.
PATCHWATCH_COOKIE_SECURE=true
# true = Client-IP aus X-Forwarded-For (nur hinter einem eigenen Reverse-Proxy).
PATCHWATCH_TRUST_PROXY=true

# ---- Betrieb --------------------------------------------------------------------------------
PATCHWATCH_TIMEZONE=Europe/Berlin
PATCHWATCH_DAILY_SUMMARY_TIME=08:00
# CVE-Feeds: Quellen (ubuntu, debian, osv) und Intervall in Minuten
PATCHWATCH_CVE_SOURCES=ubuntu,debian
PATCHWATCH_CVE_INTERVAL_MINUTES=60

# ---- Optional (Zeile aktivieren, indem du das # entfernst) -----------------------------------
# Benachrichtigungen (ntfy, Matrix, Browser) richtest du am besten in der Oberfläche ein (Benachrichtigungen).
# Interne Ziele im LAN (ntfy, Gotify, OIDC über http) nur mit exaktem Host/IP, kommagetrennt:
# PATCHWATCH_NOTIFY_ALLOWED_HOSTS=192.168.1.50,gotify.lan
# Live-WebSocket: zusätzlich erlaubte Origins (Standard: Origin muss zum Host-Header passen)
# PATCHWATCH_ALLOWED_ORIGINS=https://patchwatch.example.org
# Ubuntu: max. Seiten (je 20 CVEs) pro Lauf und Horizont des Erstabrufs in Tagen (0 = ganze Liste)
# PATCHWATCH_CVE_UBUNTU_MAX_PAGES=100
# PATCHWATCH_CVE_UBUNTU_HORIZON_DAYS=365
# ntfy als Startwert, statt in der Oberfläche: URL und Topic nur gemeinsam setzen
# PATCHWATCH_NTFY_URL=https://ntfy.example.org
# PATCHWATCH_NTFY_TOPIC=patchwatch
# PATCHWATCH_NTFY_TOKEN=

# Anmeldung per OpenID Connect (Authentik, Keycloak, Google, Microsoft Entra ...), zusätzlich zum Passwort.
# Braucht HTTPS und eine Domain. Als Redirect-URL beim Anbieter eintragen:
#   <PATCHWATCH_PUBLIC_URL>/api/v1/auth/oidc/callback
# Neue OIDC-Konten warten standardmäßig auf Freigabe durch einen Administrator (Menü Benutzer).
# PATCHWATCH_OIDC_ISSUER=https://auth.example.org/application/o/patchwatch
# PATCHWATCH_OIDC_CLIENT_ID=
# PATCHWATCH_OIDC_CLIENT_SECRET=
# Nur nötig, wenn PATCHWATCH_PUBLIC_URL fehlt:
# PATCHWATCH_OIDC_REDIRECT_URL=https://patchwatch.example.org/api/v1/auth/oidc/callback
# PATCHWATCH_OIDC_NAME=Authentik
# PATCHWATCH_OIDC_ALLOWED_EMAILS=admin@example.org,ops@example.org
# PATCHWATCH_OIDC_ALLOWED_DOMAINS=example.org
