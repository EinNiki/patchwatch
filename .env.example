# Kopieren nach .env und Werte setzen. .env gehört nicht ins Repository.
# URL-sicheres Passwort erzeugen: openssl rand -hex 24
POSTGRES_PASSWORD=
# Image-Tag aus ghcr.io (latest = Stand von dev/main, dev, sha-<commit> oder v1.2.3)
# PATCHWATCH_VERSION=latest
# Domain des TLS-Proxys (startet mit `docker compose up -d`; ohne Angabe: localhost mit lokalem Zertifikat)
# PATCHWATCH_DOMAIN=patchwatch.example.org
# PATCHWATCH_HTTP_PORT=80
# PATCHWATCH_HTTPS_PORT=443
# Adresse, auf der der Proxy lauscht (Standard 0.0.0.0 = alle Schnittstellen). Die Instanz gehört nur ins Heimnetz
# oder hinter ein VPN: z. B. die LAN-Adresse des Hosts eintragen (192.168.1.10) oder 127.0.0.1 hinter eigenem Proxy.
# PATCHWATCH_BIND=0.0.0.0
# PATCHWATCH_TIMEZONE=Europe/Berlin
# PATCHWATCH_DAILY_SUMMARY_TIME=08:00
# CVE-Feeds: Quellen (ubuntu, debian, osv) und Intervall in Minuten
# PATCHWATCH_CVE_SOURCES=ubuntu,debian
# PATCHWATCH_CVE_INTERVAL_MINUTES=60
# Ubuntu: max. Seiten (je 20 CVEs) pro Lauf; größerer Rückstand wird über mehrere Läufe abgebaut (Standard 100)
# PATCHWATCH_CVE_UBUNTU_MAX_PAGES=100
# ntfy (optional): URL und Topic nur gemeinsam setzen
# PATCHWATCH_NTFY_URL=https://ntfy.example.org
# PATCHWATCH_NTFY_TOPIC=patchwatch
# PATCHWATCH_NTFY_TOKEN=
# Benachrichtigungskanäle in der UI: Schlüssel zum Verschlüsseln gespeicherter Geheimnisse (32 Byte, base64).
# Erzeugen: openssl rand -base64 32 -- und getrennt von der Datenbank sichern! Ohne ihn sind die Geheimnisse unlesbar.
# PATCHWATCH_SECRET_KEY=
# Interne Ziele (Gotify/ntfy im LAN) nur mit exaktem Host/IP, kommagetrennt. Loopback und 169.254.0.0/16 bleiben gesperrt.
# PATCHWATCH_NOTIFY_ALLOWED_HOSTS=gotify.lan,10.0.0.5
# Live-WebSocket: zusätzlich erlaubte Origins (Standard: Origin muss zum Host-Header passen)
# PATCHWATCH_ALLOWED_ORIGINS=https://patchwatch.example.org
# Start-Passwort für den Benutzer "admin" beim allerersten Start (mind. 12 Zeichen, kein Standardwert).
# Leer lassen: der Server erzeugt ein Zufallspasswort und zeigt es einmal im Log (docker compose logs server).
# In beiden Fällen ist beim ersten Login ein Passwortwechsel nötig, wenn das Passwort erzeugt wurde.
# PATCHWATCH_ADMIN_PASSWORD=

# Anmeldung per OpenID Connect (Authentik, Keycloak, Google, Microsoft Entra ...), zusätzlich zum Passwort.
# Beim Provider einen Client anlegen (Authorization Code, Client-Secret) und als Redirect-URL eintragen:
#   https://patchwatch.example.org/api/v1/auth/oidc/callback
# Wer sich anmelden darf, MUSS festgelegt werden (E-Mail-Liste und/oder Domains), sonst startet der Server nicht.
# PATCHWATCH_OIDC_ISSUER=https://auth.example.org/application/o/patchwatch
# PATCHWATCH_OIDC_CLIENT_ID=
# PATCHWATCH_OIDC_CLIENT_SECRET=
# PATCHWATCH_OIDC_REDIRECT_URL=https://patchwatch.example.org/api/v1/auth/oidc/callback
# PATCHWATCH_OIDC_NAME=Authentik
# PATCHWATCH_OIDC_ALLOWED_EMAILS=admin@example.org,ops@example.org
# PATCHWATCH_OIDC_ALLOWED_DOMAINS=example.org
